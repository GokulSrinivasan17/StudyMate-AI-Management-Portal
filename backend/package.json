{
  "name": "education-management-portal-backend",
  "version": "1.0.0",
  "description": "Production-grade RESTful API backend for Education Management Portal with Node.js, Express, Prisma ORM, Gemini AI, Telegram Bot, and Email Services",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "db:init": "prisma db push && node prisma/seed.js"
  },
  "keywords": [
    "education",
    "express",
    "prisma",
    "gemini-ai",
    "telegram-bot",
    "jwt",
    "rbac"
  ],
  "author": "SmartEdu AI Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "latest",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.0",
    "resend": "^6.20.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0"
  }
}
